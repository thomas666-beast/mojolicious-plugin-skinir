<!DOCTYPE html>
<html lang="<%= $locale %>" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrf_token %>">
  <title><%= $name %></title>
  <link rel="stylesheet" href="/skinir/skinir.css?v=<%= $v %>">
% for my $href (@$styles) {
  <link rel="stylesheet" href="<%= $href %>">
% }
  <script>
    (function () {
      try {
        var t = localStorage.getItem('skinir-theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="h-full bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
  <div id="app" v-cloak></div>
  <noscript>This panel requires JavaScript.</noscript>
  <script id="skinir-config" type="application/json"><%== $config %></script>
  <script src="<%= $vue %>"></script>
  <script src="/skinir/app.js?v=<%= $v %>"></script>
% for my $src (@$scripts) {
  <script src="<%= $src %>"></script>
% }
  <script>Skinir.boot();</script>
</body>
</html>
